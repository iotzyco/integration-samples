# Service addresses
IDENTITY_API_BASE_URL=https://http-identity.umecdev.deviot.cloud
API_BASE_URL=https://api.rumecdev.deviot.cloud

# Authorization credentials for Emulators API (OAuth2 Client Credentials)
IDENTITY_CLIENT_ID=<authorized emulators client id>
IDENTITY_CLIENT_SECRET=<authorized emulators client secret>
IDENTITY_GRANT_TYPE=client_credentials

# Authorization credentials for Mobile API (user)
USER_NAME=<your username>
PASSWORD=<your password>

# Device parameters
VENDOR_CODE=umec
MODEL_CODE=powermaster
FIRMWARE_VERSION=0.01
DEVICE_SERIAL=

# Sensor parameters for testing
SENSOR_CODE=throttle_line01
SENSOR_VALUE=8
